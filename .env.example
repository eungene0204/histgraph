# 공공데이터포털 https://www.data.go.kr 마이페이지 > 인증키
DATA_GO_KR_API_KEY=

# 문화공공데이터광장 https://www.culture.go.kr/data 마이페이지 > 서비스키
CULTURE_API_KEY=

# 한국영상자료원 KMDb https://www.kmdb.or.kr/info/api/apiList
KMDB_API_KEY=

# 위키미디어 API 는 User-Agent 에 연락처를 요구합니다.
# 미설정 시 GitHub noreply 주소가 쓰입니다.
HISTGRAPH_CONTACT=

# --- 가입·로그인 (없으면 단추는 서 있되 "아직 준비 중"이라고 답한다) ------
# 구글 클라우드 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
# 승인된 리디렉션 URI 에 아래 둘을 **그대로** 넣는다:
#   https://www.histgraph.space/api/auth/callback
#   http://127.0.0.1:8100/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 세션 쿠키를 서명하는 열쇠. 32자 이상. 만드는 법:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# **이 값을 바꾸면 로그인한 사람이 전부 로그아웃된다.**
HISTGRAPH_SESSION_SECRET=

# 가입자 표가 사는 곳 — Neon Postgres 연결 문자열 (Neon 대시보드에서 복사).
#   postgresql://사용자:비밀번호@ep-....neon.tech/dbname?sslmode=require
#
# **로컬에서는 비워 둬도 된다** — data/accounts.sqlite 에 같은 표를 세운다.
# 배포(Vercel)에는 반드시 있어야 한다: 서버리스 함수는 파일에 못 쓴다.
# 표를 세우는 것은 한 번:  uv run histgraph accounts --init
DATABASE_URL=

# 관리자로 표시할 이메일 (쉼표로 여럿). 비워 두면 관리자가 없다.
HISTGRAPH_ADMIN_EMAILS=

# 내 역사를 표에 담을 때 잠그는 **큰 열쇠** (봉투 암호화 — src/histgraph/secretbox.py).
#   uv run histgraph datakey --new     로 만들고
#   .env 와 배포 환경변수에 **같은 값**을 넣는다 (다르면 서로의 봉투를 못 연다).
# 비워 두면 예전처럼 평문으로 담긴다 — 로컬 개발에서는 그래도 된다.
HISTGRAPH_DATA_KEY=
# 열쇠를 갈 때만 잠깐. 옛 열쇠를 여기 두고 `histgraph datakey --seal` 을 돌린 뒤 지운다.
HISTGRAPH_DATA_KEY_OLD=

# --- 개인 역사 해석 (사용자가 쓴 이야기를 읽어 사건으로 뽑는다) --------------
# OpenRouter 열쇠 https://openrouter.ai/settings/keys
# 무료 모델(`:free`)은 분당 20회, 하루 50회 — 크레딧을 $10 이상 사 두면 1,000회.
OPENROUTER_API_KEY=
# 무료 모델 중 한국어·JSON 스키마가 함께 되는 것 (2026-09-08 실측).
# 예비: dots-studio/dots-3-note-preview:free · liquid/lfm-2.5-2.6b:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
