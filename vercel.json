{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{web/**,tools/**,tests/**,.venv/**,node_modules/**,**/__pycache__/**,data/cache/**,data/raw/**,data/histgraph.sqlite,*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__p=:path*"
    },
    {
      "source": "/n",
      "destination": "/api?__p=n/"
    },
    {
      "source": "/n/",
      "destination": "/api?__p=n/"
    },
    {
      "source": "/n/:id*",
      "destination": "/api?__p=n/:id*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?__p=sitemap.xml"
    }
  ]
}
